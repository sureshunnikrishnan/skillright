# Copy to .env and fill in values. dotenv loads .env automatically.

# SQLite database path (default: ~/.skillright/skillright.db)
# DB_PATH=

# GitHub personal access token (optional)
GITHUB_TOKEN=

# Bitbucket access token (required when indexing Bitbucket).
# Use Bearer-capable access token with scope read:repository:bitbucket (or repository).
BITBUCKET_TOKEN=

# Default git ref when none is specified (default: main)
DEFAULT_GIT_REF=main
