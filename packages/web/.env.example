# Copy to .env.local. Next.js loads this file automatically.
# @skillright/backend also reads packages/backend/.env and a repo-root .env.

# SQLite database path (default: ~/.skillright/skillright.db)
# DB_PATH=

# GitHub personal access token (optional, used when indexing private repos)
# GITHUB_TOKEN=

# Bitbucket access token (required when indexing Bitbucket).
# Bearer auth; scope: read:repository:bitbucket (or repository for access tokens).
# BITBUCKET_TOKEN=

# Default git ref when none is specified (default: main)
# DEFAULT_GIT_REF=main
